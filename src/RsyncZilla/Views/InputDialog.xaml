<Window x:Class="RsyncZilla.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Folder" Height="170" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0" Foreground="#202124"
        FontFamily="Segoe UI, Arial">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="PromptLabel" Text="Folder name:" FontWeight="SemiBold" Foreground="#202124" Margin="0,0,0,8"/>

        <TextBox Grid.Row="1" x:Name="InputTextBox" 
                 Background="#FFFFFF" Foreground="#000000" BorderBrush="#B0B0B0" 
                 Padding="6,4" Margin="0,0,0,16" KeyDown="InputTextBox_KeyDown"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="CancelButton_Click" 
                    Background="#E1E1E1" Foreground="#000000" BorderBrush="#ADADAD" 
                    Padding="14,5" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Content="OK" Click="OkButton_Click" 
                    Background="#0078D7" Foreground="#FFFFFF" FontWeight="SemiBold" BorderBrush="#005A9E"
                    Padding="16,5" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
