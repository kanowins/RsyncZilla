<Window x:Class="RsyncZilla.Views.ConnectionManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestor de Conexiones - RsyncZilla"
        Height="420" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5" Foreground="#111111"
        FontFamily="Segoe UI, Arial"
        MinHeight="300" MinWidth="500">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header explanation -->
        <TextBlock Grid.Row="0" Text="Conexiones guardadas (las contraseñas nunca se almacenan por seguridad):" 
                   FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,10"/>

        <!-- DataGrid of connections -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="3">
            <DataGrid x:Name="ConnectionsGrid"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EAEAEA"
                      Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F9FAFB"
                      MouseDoubleClick="ConnectionsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="160"/>
                    <DataGridTextColumn Header="Servidor (Host)" Binding="{Binding Host}" Width="180"/>
                    <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="110"/>
                    <DataGridTextColumn Header="Puerto" Binding="{Binding Port}" Width="65"/>
                    <DataGridTextColumn Header="Último uso" Binding="{Binding LastUsed, StringFormat='dd/MM/yyyy HH:mm'}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Action buttons -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="🗑️ Eliminar" Click="DeleteButton_Click"
                        Background="#F5F5F5" Foreground="#C62828" BorderBrush="#CCCCCC"
                        Padding="12,5" FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Click="CancelButton_Click"
                        Background="#F5F5F5" Foreground="#333333" BorderBrush="#CCCCCC"
                        Padding="14,5" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="🔌 Conectar" Click="ConnectButton_Click"
                        Background="#0078D7" Foreground="#FFFFFF" BorderBrush="#005A9E"
                        Padding="16,5" FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
