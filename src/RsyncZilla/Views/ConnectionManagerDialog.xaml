<Window x:Class="RsyncZilla.Views.ConnectionManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Site Manager - RsyncZilla"
        Icon="pack://application:,,,/RsyncZilla;component/app_icon.png"
        Height="450" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5" Foreground="#111111"
        FontFamily="Segoe UI, Arial"
        MinHeight="320" MinWidth="550">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header explanation -->
        <TextBlock Grid.Row="0" Text="Saved sites (passwords are never stored for security reasons):" 
                   FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,10"/>

        <!-- DataGrid of connections -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="3">
            <DataGrid x:Name="ConnectionsGrid"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EAEAEA"
                      Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F9FAFB"
                      MouseDoubleClick="ConnectionsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Site Name" Binding="{Binding Name}" Width="150" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="160"/>
                    <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="100"/>
                    <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="55"/>
                    <DataGridTextColumn Header="Last Local Path" Binding="{Binding LastLocalPath}" Width="140"/>
                    <DataGridTextColumn Header="Last Remote Path" Binding="{Binding LastRemotePath}" Width="140"/>
                    <DataGridTextColumn Header="Last Used" Binding="{Binding LastUsed, StringFormat='MM/dd/yyyy HH:mm'}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Action buttons -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Click="NewSiteButton_Click"
                        Background="#0078D7" Foreground="#FFFFFF" BorderBrush="#005A9E"
                        Padding="12,5" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource FluentNewFolderIcon}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="New Site" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Click="EditSiteButton_Click"
                        Background="#F5F5F5" Foreground="#333333" BorderBrush="#CCCCCC"
                        Padding="12,5" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource FluentEditIcon}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Edit Site" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Click="ImportFileZillaButton_Click"
                        Background="#F0F7FF" Foreground="#0078D7" BorderBrush="#0078D7"
                        Padding="12,5" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource FluentSitesIcon}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Import from FileZilla..." VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Click="DeleteButton_Click"
                        Background="#F5F5F5" Foreground="#C62828" BorderBrush="#CCCCCC"
                        Padding="12,5" FontWeight="SemiBold" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource FluentDeleteIcon}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Delete" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="CancelButton_Click" IsCancel="True"
                        Background="#F5F5F5" Foreground="#333333" BorderBrush="#CCCCCC"
                        Padding="14,5" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Click="ConnectButton_Click"
                        Background="#0078D7" Foreground="#FFFFFF" BorderBrush="#005A9E"
                        Padding="16,5" FontWeight="SemiBold" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource FluentConnectIcon}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Connect" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
