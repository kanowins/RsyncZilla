<Window x:Class="RsyncZilla.Views.ConnectCredentialsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect to Site"
        Icon="pack://application:,,,/RsyncZilla;component/app_icon.png"
        Width="440" Height="270"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5" Foreground="#111111"
        FontFamily="Segoe UI, Segoe UI Emoji, Arial"
        ResizeMode="NoResize">
    
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Form -->
            <RowDefinition Height="*"/>    <!-- Spacer -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="SiteTitleTextBlock" Text="Server Connection" FontSize="15" FontWeight="SemiBold" Foreground="#005A9E"/>
            <TextBlock x:Name="HostInfoTextBlock" Text="Host: 192.168.1.1:22" FontSize="12" Foreground="#666666" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Form fields -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Username -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Username:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#333333"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="UsernameTextBox" Padding="6,4" Height="28" VerticalContentAlignment="Center"/>

            <!-- Password -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Password:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#333333"/>
            <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="PasswordBoxInput" Padding="6,4" Height="28" VerticalContentAlignment="Center" KeyDown="PasswordBoxInput_KeyDown"/>
        </Grid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="CancelButton_Click" IsCancel="True"
                    Background="#F5F5F5" Foreground="#333333" BorderBrush="#CCCCCC"
                    Padding="14,5" Margin="0,0,8,0" Cursor="Hand"/>
            
            <Button Click="ConnectButton_Click" IsDefault="True"
                    Background="#0078D7" Foreground="#FFFFFF" BorderBrush="#005A9E"
                    Padding="16,5" FontWeight="SemiBold" Cursor="Hand">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource FluentConnectIcon}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Connect" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
