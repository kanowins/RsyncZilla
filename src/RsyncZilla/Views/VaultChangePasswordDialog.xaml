<Window x:Class="RsyncZilla.Views.VaultChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Master Password - RsyncZilla"
        Icon="pack://application:,,,/RsyncZilla;component/app_icon.png"
        Width="460" Height="330"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5" Foreground="#111111"
        FontFamily="Segoe UI, Segoe UI Emoji, Arial"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Form -->
            <RowDefinition Height="Auto"/> <!-- Error msg -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="{StaticResource FluentKeyIcon}" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Change Master Password" FontSize="15" FontWeight="SemiBold" Foreground="#005A9E"/>
                <TextBlock Text="Enter your current password and choose a new one." FontSize="12" Foreground="#666666" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Form fields -->
        <Grid Grid.Row="1" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Current Password -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Current Password:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#333333"/>
            <PasswordBox Grid.Row="0" Grid.Column="1" x:Name="CurrentPasswordBox" Padding="6,4" Height="28" VerticalContentAlignment="Center"/>

            <!-- New Password -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="New Password:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#333333"/>
            <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="NewPasswordBox" Padding="6,4" Height="28" VerticalContentAlignment="Center"/>

            <!-- Confirm New Password -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Confirm New Password:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#333333"/>
            <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="ConfirmNewPasswordBox" Padding="6,4" Height="28" VerticalContentAlignment="Center" KeyDown="ConfirmNewPasswordBox_KeyDown"/>
        </Grid>

        <!-- Error message -->
        <TextBlock Grid.Row="2" x:Name="ErrorMessageTextBlock" Foreground="#DC2626" FontSize="12" Margin="0,6,0,6" Visibility="Collapsed" TextWrapping="Wrap"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Click="CancelButton_Click" IsCancel="True"
                    Background="#F5F5F5" Foreground="#333333" BorderBrush="#CCCCCC"
                    Padding="14,5" Margin="0,0,8,0" Cursor="Hand"/>

            <Button Click="SaveButton_Click" IsDefault="True"
                    Background="#0078D7" Foreground="#FFFFFF" BorderBrush="#005A9E"
                    Padding="16,5" FontWeight="SemiBold" Cursor="Hand">
                <TextBlock Text="Change Password" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
