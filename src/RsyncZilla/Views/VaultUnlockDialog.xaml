<Window x:Class="RsyncZilla.Views.VaultUnlockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unlock Password Vault - RsyncZilla"
        Icon="pack://application:,,,/RsyncZilla;component/app_icon.png"
        Width="440" Height="250"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5" Foreground="#111111"
        FontFamily="Segoe UI, Segoe UI Emoji, Arial"
        ResizeMode="NoResize">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Input -->
            <RowDefinition Height="Auto"/> <!-- Error msg -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="{StaticResource FluentLockIcon}" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Unlock Password Vault" FontSize="15" FontWeight="SemiBold" Foreground="#005A9E"/>
                <TextBlock Text="Enter your master password to unlock saved credentials." FontSize="12" Foreground="#666666" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Input -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Master Password:" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PasswordBoxInput" Padding="6,4" Height="28" VerticalContentAlignment="Center" KeyDown="PasswordBoxInput_KeyDown"/>
        </StackPanel>

        <!-- Error message -->
        <TextBlock Grid.Row="2" x:Name="ErrorMessageTextBlock" Text="Incorrect master password. Please try again."
                   Foreground="#DC2626" FontSize="12" Margin="0,4,0,4" Visibility="Collapsed" TextWrapping="Wrap"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Click="CancelButton_Click" IsCancel="True"
                    Background="#F5F5F5" Foreground="#333333" BorderBrush="#CCCCCC"
                    Padding="14,5" Margin="0,0,8,0" Cursor="Hand"/>

            <Button Click="UnlockButton_Click" IsDefault="True"
                    Background="#0078D7" Foreground="#FFFFFF" BorderBrush="#005A9E"
                    Padding="16,5" FontWeight="SemiBold" Cursor="Hand">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource FluentUnlockIcon}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Unlock" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
