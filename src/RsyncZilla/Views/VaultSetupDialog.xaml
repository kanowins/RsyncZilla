<Window x:Class="RsyncZilla.Views.VaultSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enable Password Vault - RsyncZilla"
        Icon="pack://application:,,,/RsyncZilla;component/app_icon.png"
        Width="480" Height="360"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5" Foreground="#111111"
        FontFamily="Segoe UI, Segoe UI Emoji, Arial"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Warning banner -->
            <RowDefinition Height="*"/>    <!-- Form -->
            <RowDefinition Height="Auto"/> <!-- Error message -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="{StaticResource FluentLockIcon}" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Set Up Encrypted Vault" FontSize="16" FontWeight="SemiBold" Foreground="#005A9E"/>
                <TextBlock Text="Protect your saved server credentials with a Master Password." FontSize="12" Foreground="#666666" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Warning banner -->
        <Border Grid.Row="1" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,14">
            <TextBlock Text="⚠️ Important: Your master password cannot be recovered. If you forget it, you will need to reset the vault and re-enter your site passwords."
                       FontSize="11.5" Foreground="#92400E" TextWrapping="Wrap" LineHeight="16"/>
        </Border>

        <!-- Form fields -->
        <Grid Grid.Row="2" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Master Password -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Master Password:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#333333"/>
            <PasswordBox Grid.Row="0" Grid.Column="1" x:Name="MasterPasswordBox" Padding="6,4" Height="28" VerticalContentAlignment="Center"/>

            <!-- Confirm Password -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Confirm Password:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#333333"/>
            <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="ConfirmPasswordBox" Padding="6,4" Height="28" VerticalContentAlignment="Center" KeyDown="ConfirmPasswordBox_KeyDown"/>
        </Grid>

        <!-- Error message -->
        <TextBlock Grid.Row="3" x:Name="ErrorMessageTextBlock" Foreground="#DC2626" FontSize="12" Margin="0,6,0,6" Visibility="Collapsed" TextWrapping="Wrap"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Click="CancelButton_Click" IsCancel="True"
                    Background="#F5F5F5" Foreground="#333333" BorderBrush="#CCCCCC"
                    Padding="14,5" Margin="0,0,8,0" Cursor="Hand"/>

            <Button Click="EnableButton_Click" IsDefault="True"
                    Background="#0078D7" Foreground="#FFFFFF" BorderBrush="#005A9E"
                    Padding="16,5" FontWeight="SemiBold" Cursor="Hand">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource FluentLockIcon}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Enable Vault" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
