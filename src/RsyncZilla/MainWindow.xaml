<Window x:Class="RsyncZilla.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RsyncZilla.ViewModels"
        xmlns:converters="clr-namespace:RsyncZilla.Views.Converters"
        mc:Ignorable="d"
        Title="RsyncZilla - Cliente SFTP con sincronización verificada rsync"
        Height="780" Width="1200"
        MinHeight="600" MinWidth="950"
        Background="#F0F2F5"
        Foreground="#1A1A1A"
        FontFamily="Segoe UI, Segoe UI Emoji, Arial"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter"/>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Common Control Styles for Windows Light Theme -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#ABADB3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="CaretBrush" Value="#000000"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="#6D6D6D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#ABADB3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="CaretBrush" Value="#000000"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="#6D6D6D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078D7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A86D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CCCCCC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#BDBDBD"/>
                                <Setter Property="Foreground" Value="#757575"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5F1FB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CCE4F7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows Native Light DataGrid Styling -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EAEAEA"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F9FA"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F2F5"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#D8D8D8"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5F3FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CCE8FF"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Windows Native TabControl Styling -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#E9ECEF"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="#D0D0D0" BorderThickness="1,1,1,0"
                                CornerRadius="3,3,0,0" Margin="0,0,3,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#0078D7"/>
                                <Setter TargetName="tabBorder" Property="BorderThickness" Value="1,2,1,0"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#F8F9FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Quick Connect Bar -->
            <RowDefinition Height="*"/>    <!-- Dual Explorer Panels -->
            <RowDefinition Height="Auto"/> <!-- Splitter -->
            <RowDefinition Height="200" MinHeight="100"/> <!-- Transfers & Logs -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. QUICK CONNECT BAR (WINDOWS LIGHT) -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D0D4DC" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Host -->
                <TextBlock Grid.Column="0" Text="Servidor:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#333333"/>
                <TextBox Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" 
                         IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"
                         ToolTip="Ej: sftp.ejemplo.com o 192.168.1.50" Margin="0,0,10,0"/>

                <!-- User -->
                <TextBlock Grid.Column="2" Text="Usuario:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#333333"/>
                <TextBox Grid.Column="3" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"
                         ToolTip="Usuario SSH / SFTP" Margin="0,0,10,0"/>

                <!-- Password -->
                <TextBlock Grid.Column="4" Text="Contraseña:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#333333"/>
                <PasswordBox Grid.Column="5" x:Name="PasswordInput" 
                             IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"
                             Margin="0,0,10,0"/>

                <!-- Port -->
                <TextBlock Grid.Column="6" Text="Puerto:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#333333"/>
                <TextBox Grid.Column="7" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"
                         Margin="0,0,12,0"/>

                <!-- Connect Button -->
                <Button Grid.Column="8" 
                        Content="{Binding ConnectionButtonText}"
                        Command="{Binding ConnectCommand}"
                        CommandParameter="{Binding ElementName=PasswordInput}"
                        IsEnabled="{Binding IsConnecting, Converter={StaticResource InverseBoolConverter}}"
                        Style="{StaticResource AccentButtonStyle}"
                        MinWidth="120" Height="28"/>

                <!-- Connection Indicator -->
                <StackPanel Grid.Column="9" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConnectionStatusIndicator}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="#333333"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. DUAL EXPLORER PANELS -->
        <Grid Grid.Row="1" Margin="8,6,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="Auto"/> <!-- Center Actions -->
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: LOCAL MACHINE -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="6"
                    AllowDrop="True" DragOver="LocalDataGrid_DragOver" DragEnter="LocalDataGrid_DragEnter" Drop="LocalDataGrid_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Navigation Toolbar -->
                        <RowDefinition Height="*"/>    <!-- File List -->
                    </Grid.RowDefinitions>

                    <!-- Local Header & Path Bar -->
                    <Grid Grid.Row="0" Margin="2,2,2,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="💻" FontSize="13" Margin="0,0,3,0"/>
                            <TextBlock Text="Local:" FontWeight="Bold" Foreground="#0066CC"/>
                        </StackPanel>

                        <TextBox Grid.Column="1" x:Name="LocalPathTextBox" 
                                 Text="{Binding LocalBrowser.CurrentPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 KeyDown="LocalPathTextBox_KeyDown" Margin="0,0,4,0"/>

                        <Button Grid.Column="2" Content="⬆️" ToolTip="Subir un nivel" 
                                Command="{Binding LocalBrowser.NavigateUpCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Width="28" Margin="0,0,4,0"/>

                        <Button Grid.Column="3" Content="🔄" ToolTip="Actualizar directorio" 
                                Command="{Binding LocalBrowser.RefreshCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Width="28"/>
                    </Grid>

                    <!-- Local DataGrid -->
                    <DataGrid Grid.Row="1" x:Name="LocalDataGrid"
                              ItemsSource="{Binding LocalBrowser.Items}"
                              SelectedItem="{Binding LocalBrowser.SelectedItem, Mode=TwoWay}"
                              MouseDoubleClick="LocalDataGrid_MouseDoubleClick"
                              AllowDrop="True"
                              PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown"
                              PreviewMouseLeftButtonDown="LocalDataGrid_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="LocalDataGrid_PreviewMouseLeftButtonUp"
                              MouseMove="LocalDataGrid_MouseMove"
                              DragOver="LocalDataGrid_DragOver"
                              DragEnter="LocalDataGrid_DragEnter"
                              Drop="LocalDataGrid_Drop">
                        <DataGrid.ContextMenu>
                            <ContextMenu Background="#FFFFFF" Foreground="#111111" BorderBrush="#CCCCCC">
                                <MenuItem Header="🚀 Subir con rsync al servidor" Command="{Binding UploadSelectedCommand}"/>
                                <Separator Background="#E0E0E0"/>
                                <MenuItem Header="📁 Nueva carpeta local..." Click="NewLocalFolder_Click"/>
                                <MenuItem Header="🗑️ Eliminar archivo/carpeta" Click="DeleteLocalItem_Click"/>
                                <Separator Background="#E0E0E0"/>
                                <MenuItem Header="🔄 Actualizar lista" Command="{Binding LocalBrowser.RefreshCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Nombre" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,2">
                                            <TextBlock Text="{Binding IconEmoji}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="#111111"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Tamaño" Binding="{Binding DisplaySize}" Width="90"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding DisplayType}" Width="110"/>
                            <DataGridTextColumn Header="Modificado" Binding="{Binding LastWriteTime, StringFormat='dd/MM/yyyy HH:mm'}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- CENTER TRANSFER BUTTONS -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0" Width="44">
                <Button Content="⏩" ToolTip="Subir seleccionados al servidor usando rsync"
                        Command="{Binding UploadSelectedCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="36" FontSize="15" Margin="0,0,0,8"/>

                <Button Content="⏪" ToolTip="Descargar seleccionados del servidor usando rsync"
                        Command="{Binding DownloadSelectedCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="36" FontSize="15"/>
            </StackPanel>

            <!-- RIGHT PANEL: REMOTE SFTP SERVER -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="6"
                    AllowDrop="True" DragOver="RemoteDataGrid_DragOver" DragEnter="RemoteDataGrid_DragEnter" Drop="RemoteDataGrid_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Navigation Toolbar -->
                        <RowDefinition Height="*"/>    <!-- Remote File List -->
                    </Grid.RowDefinitions>

                    <!-- Remote Header & Path Bar -->
                    <Grid Grid.Row="0" Margin="2,2,2,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="🌐" FontSize="13" Margin="0,0,3,0"/>
                            <TextBlock Text="Remoto (SFTP):" FontWeight="Bold" Foreground="#0E7036"/>
                        </StackPanel>

                        <TextBox Grid.Column="1" x:Name="RemotePathTextBox"
                                 Text="{Binding RemoteBrowser.CurrentPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 KeyDown="RemotePathTextBox_KeyDown"
                                 IsEnabled="{Binding IsConnected}"
                                 Margin="0,0,4,0"/>

                        <Button Grid.Column="2" Content="⬆️" ToolTip="Subir un nivel remoto"
                                Command="{Binding RemoteBrowser.NavigateUpCommand}"
                                IsEnabled="{Binding IsConnected}"
                                Style="{StaticResource SecondaryButtonStyle}" Width="28" Margin="0,0,4,0"/>

                        <Button Grid.Column="3" Content="🔄" ToolTip="Actualizar directorio remoto"
                                Command="{Binding RemoteBrowser.RefreshCommand}"
                                IsEnabled="{Binding IsConnected}"
                                Style="{StaticResource SecondaryButtonStyle}" Width="28"/>
                    </Grid>

                    <!-- Remote DataGrid -->
                    <DataGrid Grid.Row="1" x:Name="RemoteDataGrid"
                              ItemsSource="{Binding RemoteBrowser.Items}"
                              SelectedItem="{Binding RemoteBrowser.SelectedItem, Mode=TwoWay}"
                              MouseDoubleClick="RemoteDataGrid_MouseDoubleClick"
                              AllowDrop="True"
                              PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown"
                              PreviewMouseLeftButtonDown="RemoteDataGrid_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="RemoteDataGrid_PreviewMouseLeftButtonUp"
                              MouseMove="RemoteDataGrid_MouseMove"
                              DragOver="RemoteDataGrid_DragOver"
                              DragEnter="RemoteDataGrid_DragEnter"
                              Drop="RemoteDataGrid_Drop">
                        <DataGrid.ContextMenu>
                            <ContextMenu Background="#FFFFFF" Foreground="#111111" BorderBrush="#CCCCCC">
                                <MenuItem Header="🚀 Descargar con rsync a local" Command="{Binding DownloadSelectedCommand}"/>
                                <Separator Background="#E0E0E0"/>
                                <MenuItem Header="📁 Nueva carpeta remota..." Click="NewRemoteFolder_Click"/>
                                <MenuItem Header="🗑️ Eliminar elemento remoto" Click="DeleteRemoteItem_Click"/>
                                <Separator Background="#E0E0E0"/>
                                <MenuItem Header="🔄 Actualizar lista" Command="{Binding RemoteBrowser.RefreshCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Nombre" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,2">
                                            <TextBlock Text="{Binding IconEmoji}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="#111111"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Tamaño" Binding="{Binding DisplaySize}" Width="90"/>
                            <DataGridTextColumn Header="Permisos" Binding="{Binding Permissions}" Width="95"/>
                            <DataGridTextColumn Header="Modificado" Binding="{Binding LastWriteTime, StringFormat='dd/MM/yyyy HH:mm'}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. SPLITTER -->
        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="#D0D0D0" Cursor="SizeNS"/>

        <!-- 4. BOTTOM TABS: TRANSFERS & LOGS -->
        <TabControl Grid.Row="3" Margin="8,4,8,4">
            <!-- TAB 1: ACTIVE TRANSFERS -->
            <TabItem Header="🚀 Transferencias Activas">
                <Grid Background="#FFFFFF">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding ActiveTransfers}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Dirección" Binding="{Binding DirectionIcon}" Width="90"/>
                            <DataGridTextColumn Header="Archivo / Carpeta" Binding="{Binding FileName}" Width="200"/>
                            <DataGridTemplateColumn Header="Progreso" Width="250">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4">
                                            <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="16" Foreground="#0078D7" Background="#E0E0E0"/>
                                            <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0}%'}" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                       FontSize="11" FontWeight="Bold" Foreground="#111111"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Velocidad" Binding="{Binding Speed}" Width="100"/>
                            <DataGridTextColumn Header="ETA" Binding="{Binding Eta}" Width="80"/>
                            <DataGridTextColumn Header="Detalles" Binding="{Binding TransferredInfo}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="6">
                        <Button Content="⏹ Cancelar activa" Command="{Binding CancelTransferCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 2: COMPLETED TRANSFERS -->
            <TabItem Header="✅ Historial de Transferencias">
                <Grid Background="#FFFFFF">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding CompletedTransfers}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Estado" Binding="{Binding StatusBadge}" Width="110"/>
                            <DataGridTextColumn Header="Dirección" Binding="{Binding DirectionIcon}" Width="90"/>
                            <DataGridTextColumn Header="Archivo" Binding="{Binding FileName}" Width="220"/>
                            <DataGridTextColumn Header="ExitCode" Binding="{Binding ExitCode}" Width="70"/>
                            <DataGridTextColumn Header="Origen" Binding="{Binding SourcePath}" Width="*"/>
                            <DataGridTextColumn Header="Destino" Binding="{Binding DestinationPath}" Width="*"/>
                            <DataGridTextColumn Header="Fin" Binding="{Binding EndTime, StringFormat='HH:mm:ss'}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="6">
                        <Button Content="Limpiar historial" Command="{Binding ClearCompletedCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 3: SERVER & RSYNC CONSOLE LOG -->
            <TabItem Header="📜 Registro de Servidor y rsync">
                <Grid Background="#FAFAFA">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0" x:Name="LogListBox" 
                             ItemsSource="{Binding LogEntries}"
                             Background="#FAFAFA" BorderThickness="0"
                             FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,1">
                                    <TextBlock Text="{Binding FormattedTime, StringFormat='[{0}] '}" Foreground="#757575" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Message}" Foreground="{Binding ColorBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="6">
                        <Button Content="Limpiar consola" Command="{Binding ClearLogsCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 5. STATUS BAR -->
        <Border Grid.Row="4" Background="#E9ECEF" BorderBrush="#CED4DA" BorderThickness="0,1,0,0" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="#495057" FontSize="12" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Motor: rsync 3.3.0 portable (Cygwin64) + SSH.NET" Foreground="#6C757D" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
