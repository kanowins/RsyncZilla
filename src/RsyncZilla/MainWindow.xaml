<Window x:Class="RsyncZilla.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RsyncZilla.ViewModels"
        xmlns:models="clr-namespace:RsyncZilla.Models"
        xmlns:converters="clr-namespace:RsyncZilla.Views.Converters"
        mc:Ignorable="d"
        Title="RsyncZilla - SFTP Client with Verified rsync Synchronization"
        Icon="pack://application:,,,/RsyncZilla;component/app_icon.png"
        Height="780" Width="1200"
        MinHeight="600" MinWidth="950"
        Background="#F0F2F5"
        Foreground="#1A1A1A"
        FontFamily="Segoe UI, Segoe UI Emoji, Arial"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter"/>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>

        <!-- Connection Status Dot Style (Green when connected, Amber when connecting, Gray when disconnected) -->
        <Style x:Key="ConnectionDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="#9CA3AF"/>
            <Setter Property="Stroke" Value="#6B7280"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Fill" Value="#10B981"/>
                    <Setter Property="Stroke" Value="#059669"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                    <Setter Property="Fill" Value="#F59E0B"/>
                    <Setter Property="Stroke" Value="#D97706"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Expand/Collapse ToggleButton Style -->
        <Style x:Key="ExpandCollapseToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" SnapsToDevicePixels="True">
                            <TextBlock x:Name="Arrow" Text="▶" FontSize="10" Foreground="#555555"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="Text" Value="▼"/>
                                <Setter TargetName="Arrow" Property="Foreground" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Foreground" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vector Icon: Folder with Arrow Up inside -->
        <DataTemplate x:Key="FolderUpIconTemplate">
            <Viewbox Width="19" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="20" Height="18">
                    <!-- Back flap & tab -->
                    <Path Fill="#E8A020" Stroke="#C07800" StrokeThickness="0.6"
                          Data="M 1,3 C 1,2 1.5,1.5 2.5,1.5 L 7,1.5 L 9,3.5 L 17.5,3.5 C 18.5,3.5 19,4 19,5 L 19,16 C 19,17 18.5,17.5 17.5,17.5 L 2.5,17.5 C 1.5,17.5 1,17 1,16 Z"/>
                    <!-- Front folder pocket -->
                    <Path Fill="#FFCA28" Stroke="#C07800" StrokeThickness="0.5"
                          Data="M 1,6.5 L 19,6.5 L 19,16 C 19,17 18.5,17.5 17.5,17.5 L 2.5,17.5 C 1.5,17.5 1,17 1,16 Z"/>
                    <!-- Upward Arrow inside folder -->
                    <Path Fill="#005A9E" Stroke="#003D7A" StrokeThickness="0.4"
                          Data="M 10,4.8 L 5.2,10 L 7.8,10 L 7.8,14.8 L 12.2,14.8 L 12.2,10 L 14.8,10 Z"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Vector Icon: Refresh with tight bounds (no padding) -->
        <DataTemplate x:Key="RefreshIconTemplate">
            <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path Fill="#0078D7"
                          Data="M 17.65,6.35 C 16.2,4.9 14.21,4 12,4 C 7.58,4 4.01,7.58 4.01,12 C 4.01,16.42 7.58,20 12,20 C 15.73,20 18.84,17.45 19.73,14 L 17.65,14 C 16.83,16.33 14.61,18 12,18 C 8.69,18 6,15.31 6,12 C 6,8.69 8.69,6 12,6 C 13.66,6 15.14,6.69 16.22,7.78 L 13,11 L 20,11 L 20,4 L 17.65,6.35 Z"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Vector Icon: Terminal console (>_) -->
        <DataTemplate x:Key="TerminalIconTemplate">
            <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path Fill="#22252A" Stroke="#0078D7" StrokeThickness="1.2"
                          Data="M 2,4 C 2,2.9 2.9,2 4,2 L 20,2 C 21.1,2 22,2.9 22,4 L 22,20 C 22,21.1 21.1,22 20,22 L 4,22 C 2.9,22 2,21.1 2,20 Z"/>
                    <Path Stroke="#00D778" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M 6,8 L 11,12 L 6,16"/>
                    <Line X1="13" Y1="16" X2="18" Y2="16" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Common Control Styles for Windows Light Theme -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#ABADB3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="CaretBrush" Value="#000000"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="#6D6D6D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#ABADB3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="CaretBrush" Value="#000000"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="#6D6D6D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078D7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A86D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CCCCCC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#BDBDBD"/>
                                <Setter Property="Foreground" Value="#757575"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5F1FB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CCE4F7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows Native Light DataGrid Styling -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EAEAEA"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F9FA"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="MinRowHeight" Value="24"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F2F5"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#D8D8D8"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- Ensure DataGrid row and cell selection stay ALWAYS vibrant blue (#0078D7), never inactive grey -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0078D7"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#0078D7"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>

        <Style TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5F3FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0078D7"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ElementStyle for DataGridTextColumn to ensure vertical centering and standard horizontal margin -->
        <Style x:Key="DataGridTextCellElementStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0078D7"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Windows Native TabControl Styling -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#E9ECEF"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="#D0D0D0" BorderThickness="1,1,1,0"
                                CornerRadius="3,3,0,0" Margin="0,0,3,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#0078D7"/>
                                <Setter TargetName="tabBorder" Property="BorderThickness" Value="1,2,1,0"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#F8F9FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NewTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E9ECEF"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0078D7"/>
                                <Setter Property="Foreground" Value="#0078D7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SessionTabItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="#E9ECEF"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Padding" Value="8,4,6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="tabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4,4,0,0" Margin="{TemplateBinding Margin}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="tabBorder" Property="BorderThickness" Value="1,2,1,0"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#0078D7"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#F8F9FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Top Menu Bar -->
            <RowDefinition Height="Auto"/> <!-- 1: Quick Connect Bar -->
            <RowDefinition Height="*"/>    <!-- 2: Dual Explorer Panels -->
            <RowDefinition Height="Auto"/> <!-- 3: Splitter -->
            <RowDefinition Height="200" MinHeight="100"/> <!-- 4: Transfers & Logs -->
            <RowDefinition Height="Auto"/> <!-- 5: Status Bar -->
        </Grid.RowDefinitions>

        <!-- 0. TOP APPLICATION MENU BAR -->
        <Menu Grid.Row="0" Background="#F8F9FA" BorderBrush="#D0D4DC" BorderThickness="0,0,0,1" Padding="4,2">
            <!-- File Menu -->
            <MenuItem Header="_File">
                <MenuItem Header="_New Connection / Tab" Command="{Binding NewTabCommand}" InputGestureText="Ctrl+T">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FluentNewFolderIcon}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Site Manager..." Command="{Binding OpenSiteManagerCommand}" InputGestureText="Ctrl+S">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FluentSitesIcon}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Disconnect" Command="{Binding DisconnectCommand}" InputGestureText="Ctrl+D">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FluentDisconnectIcon}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Reconnect" Command="{Binding ReconnectCommand}" InputGestureText="Ctrl+R">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FluentReconnectIcon}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" InputGestureText="Alt+F4"/>
            </MenuItem>

            <!-- Actions / Transfers Menu -->
            <MenuItem Header="_Actions">
                <MenuItem Header="_Upload Selected" Command="{Binding UploadSelectedCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FluentUploadIcon}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Download Selected" Command="{Binding DownloadSelectedCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FluentDownloadIcon}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="New _Local Directory..." Command="{Binding LocalBrowser.CreateDirectoryCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FluentNewFolderIcon}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="New _Remote Directory..." Command="{Binding RemoteBrowser.CreateDirectoryCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FluentNewFolderIcon}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Refresh All Panels" Command="{Binding RefreshAllCommand}" InputGestureText="F5">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FluentRefreshIcon}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Refresh _Local Panel" Command="{Binding LocalBrowser.RefreshCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FluentRefreshIcon}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Refresh _Remote Panel" Command="{Binding RemoteBrowser.RefreshCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FluentRefreshIcon}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Open KiTTY _Terminal" Command="{Binding OpenRemoteTerminalCommand}" CommandParameter="{x:Null}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FluentTerminalIcon}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- Transfer Menu (FileZilla Style) -->
            <MenuItem Header="_Transfer">
                <MenuItem Header="_Overwrite Action">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FluentReconnectIcon}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                    <MenuItem Header="Overwrite if size or date differ"
                              IsCheckable="True"
                              IsChecked="{Binding IsOverwriteIfDifferent, Mode=OneWay}"
                              Command="{Binding SetFileExistsActionCommand}"
                              CommandParameter="{x:Static models:FileExistsAction.OverwriteIfDifferent}"/>
                    <MenuItem Header="Overwrite only if source is newer (--update)"
                              IsCheckable="True"
                              IsChecked="{Binding IsOverwriteIfNewer, Mode=OneWay}"
                              Command="{Binding SetFileExistsActionCommand}"
                              CommandParameter="{x:Static models:FileExistsAction.OverwriteIfNewer}"/>
                    <MenuItem Header="Overwrite always (--ignore-times)"
                              IsCheckable="True"
                              IsChecked="{Binding IsOverwriteAlways, Mode=OneWay}"
                              Command="{Binding SetFileExistsActionCommand}"
                              CommandParameter="{x:Static models:FileExistsAction.OverwriteAlways}"/>
                    <MenuItem Header="Compare by content checksum (--checksum)"
                              IsCheckable="True"
                              IsChecked="{Binding IsCompareChecksum, Mode=OneWay}"
                              Command="{Binding SetFileExistsActionCommand}"
                              CommandParameter="{x:Static models:FileExistsAction.CompareChecksum}"/>
                </MenuItem>
            </MenuItem>

            <!-- View Menu -->
            <MenuItem Header="_View">
                <MenuItem Header="Clear _Completed Transfers" Command="{Binding ClearCompletedCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FluentCompletedIcon}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Clear _Failed Transfers" Command="{Binding ClearFailedCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FluentFailedIcon}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Retry _All Failed Transfers" Command="{Binding RetryAllFailedCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FluentRefreshIcon}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Clear Server &amp; rsync _Log" Command="{Binding ClearLogsCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FluentDeleteIcon}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- Help Menu -->
            <MenuItem Header="_Help">
                <MenuItem Header="Check for _Updates..." Command="{Binding CheckForUpdatesCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FluentUpdateIcon}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="RsyncZilla on GitHub..." Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/kanowins/RsyncZilla">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FluentGitHubIcon}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Developed by Sumalab..." Command="{Binding OpenUrlCommand}" CommandParameter="https://sumalab.com">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FluentWebIcon}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_About RsyncZilla..." Command="{Binding ShowAboutCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FluentInfoIcon}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- DYNAMIC UPDATE NOTIFICATION ITEM (Appears automatically when GitHub release is newer) -->
            <MenuItem Header="{Binding UpdateService.UpdateBannerText}"
                      Command="{Binding ShowUpdateCommand}"
                      Visibility="{Binding UpdateService.IsUpdateAvailable, Converter={StaticResource BoolToVisConverter}}"
                      Background="#FFF3CD" Foreground="#856404" BorderBrush="#FFEEBA" BorderThickness="1"
                      FontWeight="Bold" Margin="12,0,0,0" Cursor="Hand"
                      ToolTip="A new version of RsyncZilla is available! Click to view release notes.">
                <MenuItem.Icon>
                    <Image Source="{StaticResource FluentUpdateIcon}" Width="16" Height="16"/>
                </MenuItem.Icon>
            </MenuItem>
        </Menu>

        <!-- 1. QUICK CONNECT BAR (WINDOWS LIGHT) -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D0D4DC" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Host -->
                <TextBlock Grid.Column="0" Text="Host:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#333333"/>
                <TextBox Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" 
                         IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"
                         KeyDown="QuickConnect_KeyDown"
                         ToolTip="e.g. sftp.example.com or 192.168.1.50" Margin="0,0,10,0"/>

                <!-- User -->
                <TextBlock Grid.Column="2" Text="Username:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#333333"/>
                <TextBox Grid.Column="3" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"
                         KeyDown="QuickConnect_KeyDown"
                         ToolTip="SSH / SFTP Username" Margin="0,0,10,0"/>

                <!-- Password -->
                <TextBlock Grid.Column="4" Text="Password:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#333333"/>
                <PasswordBox Grid.Column="5" x:Name="PasswordInput" 
                             IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"
                             KeyDown="QuickConnect_KeyDown"
                             Margin="0,0,10,0"/>

                <!-- Port -->
                <TextBlock Grid.Column="6" Text="Port:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="#333333"/>
                <TextBox Grid.Column="7" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"
                         KeyDown="QuickConnect_KeyDown"
                         Margin="0,0,12,0"/>

                <!-- Connect Button -->
                <StackPanel Grid.Column="8" Orientation="Horizontal">
                    <Button Content="{Binding ConnectionButtonText}"
                            Command="{Binding ConnectCommand}"
                            CommandParameter="{Binding ElementName=PasswordInput}"
                            IsEnabled="{Binding IsConnecting, Converter={StaticResource InverseBoolConverter}}"
                            Style="{StaticResource AccentButtonStyle}"
                            MinWidth="110" Height="28" Margin="0,0,6,0"/>

                    <Button Command="{Binding OpenSiteManagerCommand}"
                            ToolTip="Saved connections manager"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="8,3" Height="28">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{StaticResource FluentSitesIcon}" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Sites" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Connection Indicator -->
                <StackPanel Grid.Column="9" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource ConnectionDotStyle}" Width="9" Height="9" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding ConnectionStatusText}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="#333333"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. DUAL EXPLORER PANELS (UNDER CONNECTION TABS) -->
        <Grid Grid.Row="2" Margin="8,4,8,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Connection Tabs Strip across both Local and Remote -->
                <RowDefinition Height="*"/>    <!-- Dual Explorer Area -->
            </Grid.RowDefinitions>

            <!-- Connection Tabs Strip (Spans across both Local and Remote explorers) -->
            <Border Grid.Row="0" Background="#F1F3F5" BorderBrush="#D0D0D0" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Padding="6,4,6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0" ItemsSource="{Binding RemoteSessions}"
                             SelectedItem="{Binding ActiveSession, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource SessionTabItemStyle}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Title}">
                                    <Ellipse Style="{StaticResource ConnectionDotStyle}" Width="8" Height="8" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                                    <Button Command="{Binding CloseCommand}" ToolTip="Close connection" Margin="8,0,0,0" Style="{StaticResource TabCloseButtonStyle}">
                                        <TextBlock Text="✕" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Column="1" Command="{Binding NewTabCommand}" ToolTip="New connection tab" Style="{StaticResource NewTabButtonStyle}">
                        <TextBlock Text="+" FontSize="14" FontWeight="Bold" Margin="0,-1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Dual Explorers Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                    <ColumnDefinition Width="Auto"/> <!-- Center Actions -->
                    <ColumnDefinition Width="*" MinWidth="300"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT PANEL: LOCAL MACHINE -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="6"
                        PreviewMouseDown="LocalPanel_PreviewMouseDown"
                        AllowDrop="True" DragOver="LocalDataGrid_DragOver" DragEnter="LocalDataGrid_DragEnter" Drop="LocalDataGrid_Drop">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Navigation Toolbar -->
                            <RowDefinition Height="*"/>    <!-- File List -->
                        </Grid.RowDefinitions>

                        <!-- Local Header & Path Bar -->
                        <Grid Grid.Row="0" Margin="2,2,2,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Image Source="{StaticResource FluentComputerIcon}" Width="15" Height="15" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Local:" FontWeight="Bold" Foreground="#0066CC" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBox Grid.Column="1" x:Name="LocalPathTextBox" 
                                     Text="{Binding LocalBrowser.CurrentPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     KeyDown="LocalPathTextBox_KeyDown" Margin="0,0,4,0"/>

                            <Button Grid.Column="2" ToolTip="Up one level" 
                                    Command="{Binding LocalBrowser.NavigateUpCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="34" Height="26" Padding="0" Margin="0,0,4,0">
                                    <ContentControl ContentTemplate="{StaticResource FolderUpIconTemplate}" Focusable="False"/>
                            </Button>

                            <Button Grid.Column="3" ToolTip="Refresh directory" 
                                    Command="{Binding LocalBrowser.RefreshCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="34" Height="26" Padding="0" Margin="0,0,4,0">
                                <Image Source="{StaticResource FluentRefreshIcon}" Width="15" Height="15"/>
                            </Button>

                            <Button Grid.Column="4" ToolTip="Show in Windows Explorer" 
                                    Command="{Binding ShowInExplorerCommand}" CommandParameter="{Binding LocalBrowser.SelectedItem}"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="34" Height="26" Padding="0">
                                <Image Source="{StaticResource FluentExplorerIcon}" Width="15" Height="15"/>
                            </Button>
                        </Grid>

                        <!-- Local DataGrid -->
                        <DataGrid Grid.Row="1" x:Name="LocalDataGrid"
                                  ItemsSource="{Binding LocalBrowser.Items}"
                                  SelectedItem="{Binding LocalBrowser.SelectedItem, Mode=TwoWay}"
                                  MouseDoubleClick="LocalDataGrid_MouseDoubleClick"
                                  AllowDrop="True"
                                  PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown"
                                  PreviewMouseMove="DataGrid_PreviewMouseMove"
                                  PreviewMouseRightButtonUp="DataGrid_PreviewMouseRightButtonUp"
                                  PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown"
                                  PreviewMouseLeftButtonUp="DataGrid_PreviewMouseLeftButtonUp"
                                  LostMouseCapture="DataGrid_LostMouseCapture"
                                  DragOver="LocalDataGrid_DragOver"
                                  DragEnter="LocalDataGrid_DragEnter"
                                  Drop="LocalDataGrid_Drop">
                            <DataGrid.ContextMenu>
                                <ContextMenu Background="#FFFFFF" Foreground="#111111" BorderBrush="#CCCCCC">
                                    <MenuItem Header="Upload to server with rsync" Command="{Binding UploadSelectedCommand}">
                                        <MenuItem.Icon>
                                            <Image Source="{StaticResource FluentUploadIcon}" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator Background="#E0E0E0"/>
                                    <MenuItem Header="Open / Edit (F4)" Command="{Binding OpenLocalFileCommand}" CommandParameter="{Binding LocalBrowser.SelectedItem}">
                                        <MenuItem.Icon>
                                            <Image Source="{StaticResource FluentEditIcon}" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Show in Explorer" Command="{Binding ShowInExplorerCommand}" CommandParameter="{Binding LocalBrowser.SelectedItem}">
                                        <MenuItem.Icon>
                                            <Image Source="{StaticResource FluentExplorerIcon}" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator Background="#E0E0E0"/>
                                    <MenuItem Header="New local folder..." Click="NewLocalFolder_Click">
                                        <MenuItem.Icon>
                                            <Image Source="{StaticResource FluentNewFolderIcon}" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Rename..." Click="RenameLocalItem_Click">
                                        <MenuItem.Icon>
                                            <Image Source="{StaticResource FluentRenameIcon}" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Delete file/folder" Click="DeleteLocalItem_Click">
                                        <MenuItem.Icon>
                                            <Image Source="{StaticResource FluentDeleteIcon}" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator Background="#E0E0E0"/>
                                    <MenuItem Header="Refresh list" Command="{Binding LocalBrowser.RefreshCommand}">
                                        <MenuItem.Icon>
                                            <Image Source="{StaticResource FluentRefreshIcon}" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Name" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                                <!-- Icon for Parent Folder '..' -->
                                                <ContentControl ContentTemplate="{StaticResource FolderUpIconTemplate}" Focusable="False"
                                                                Margin="0,0,6,0" VerticalAlignment="Center"
                                                                Visibility="{Binding IsParent, Converter={StaticResource BoolToVisConverter}}"/>

                                                <!-- Native Windows Shell Icon for files, folders, and drives -->
                                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding IsParent, Converter={StaticResource InverseBoolToVisConverter}}"/>

                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Size" Binding="{Binding DisplaySize}" Width="90" ElementStyle="{StaticResource DataGridTextCellElementStyle}"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding DisplayType}" Width="110" ElementStyle="{StaticResource DataGridTextCellElementStyle}"/>
                                <DataGridTextColumn Header="Modified" Binding="{Binding LastWriteTime, StringFormat='dd/MM/yyyy HH:mm'}" Width="130" ElementStyle="{StaticResource DataGridTextCellElementStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- CENTER TRANSFER BUTTONS -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0" Width="46">
                    <Button ToolTip="Upload selected items to server using rsync (Local ➔ Remote)"
                            Command="{Binding UploadSelectedCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="44" Height="36" Padding="0" Margin="0,0,0,8">
                        <Image Source="{StaticResource FluentUploadIcon}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button ToolTip="Download selected items from server using rsync (Remote ➔ Local)"
                            Command="{Binding DownloadSelectedCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="44" Height="36" Padding="0">
                        <Image Source="{StaticResource FluentDownloadIcon}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- RIGHT PANEL: REMOTE SFTP SERVER -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="6"
                        PreviewMouseDown="RemotePanel_PreviewMouseDown"
                        AllowDrop="True" DragOver="RemoteDataGrid_DragOver" DragEnter="RemoteDataGrid_DragEnter" Drop="RemoteDataGrid_Drop">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Navigation Toolbar -->
                            <RowDefinition Height="*"/>    <!-- Remote File List -->
                        </Grid.RowDefinitions>

                        <!-- Remote Header & Path Bar -->
                        <Grid Grid.Row="0" Margin="2,2,2,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Image Source="{StaticResource FluentWebIcon}" Width="15" Height="15" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Remote (SFTP):" FontWeight="Bold" Foreground="#0E7036" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBox Grid.Column="1" x:Name="RemotePathTextBox"
                                     Text="{Binding RemoteBrowser.CurrentPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     KeyDown="RemotePathTextBox_KeyDown"
                                     IsEnabled="{Binding IsConnected}"
                                     Margin="0,0,4,0"/>

                            <Button Grid.Column="2" ToolTip="Up one level"
                                     Command="{Binding RemoteBrowser.NavigateUpCommand}"
                                     IsEnabled="{Binding IsConnected}"
                                     Style="{StaticResource SecondaryButtonStyle}" Width="34" Height="26" Padding="0" Margin="0,0,4,0">
                                <ContentControl ContentTemplate="{StaticResource FolderUpIconTemplate}" Focusable="False"/>
                            </Button>

                            <Button Grid.Column="3" ToolTip="Refresh remote directory"
                                     Command="{Binding RemoteBrowser.RefreshCommand}"
                                     IsEnabled="{Binding IsConnected}"
                                     Style="{StaticResource SecondaryButtonStyle}" Width="34" Height="26" Padding="0" Margin="0,0,4,0">
                                <Image Source="{StaticResource FluentRefreshIcon}" Width="15" Height="15"/>
                            </Button>

                            <Button Grid.Column="4" ToolTip="Open remote terminal at this directory (Ctrl+T)"
                                     Command="{Binding OpenRemoteTerminalCommand}"
                                     IsEnabled="{Binding IsConnected}"
                                     Style="{StaticResource SecondaryButtonStyle}" Width="34" Height="26" Padding="0">
                                <Image Source="{StaticResource FluentTerminalIcon}" Width="15" Height="15"/>
                            </Button>
                        </Grid>

                        <!-- Remote DataGrid -->
                        <DataGrid Grid.Row="1" x:Name="RemoteDataGrid"
                                  ItemsSource="{Binding RemoteBrowser.Items}"
                                  SelectedItem="{Binding RemoteBrowser.SelectedItem, Mode=TwoWay}"
                                  MouseDoubleClick="RemoteDataGrid_MouseDoubleClick"
                                  AllowDrop="True"
                                  PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown"
                                  PreviewMouseMove="DataGrid_PreviewMouseMove"
                                  PreviewMouseRightButtonUp="DataGrid_PreviewMouseRightButtonUp"
                                  PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown"
                                  PreviewMouseLeftButtonUp="DataGrid_PreviewMouseLeftButtonUp"
                                  LostMouseCapture="DataGrid_LostMouseCapture"
                                  DragOver="RemoteDataGrid_DragOver"
                                  DragEnter="RemoteDataGrid_DragEnter"
                                  Drop="RemoteDataGrid_Drop">
                            <DataGrid.ContextMenu>
                                <ContextMenu Background="#FFFFFF" Foreground="#111111" BorderBrush="#CCCCCC">
                                    <MenuItem Header="Download to local with rsync" Command="{Binding DownloadSelectedCommand}">
                                        <MenuItem.Icon>
                                            <Image Source="{StaticResource FluentDownloadIcon}" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator Background="#E0E0E0"/>
                                    <MenuItem Header="View / Edit (F4)" Command="{Binding EditRemoteFileCommand}" CommandParameter="{Binding RemoteBrowser.SelectedItem}">
                                        <MenuItem.Icon>
                                            <Image Source="{StaticResource FluentEditIcon}" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Open terminal here (Ctrl+T)" Command="{Binding OpenRemoteTerminalCommand}" CommandParameter="{Binding RemoteBrowser.SelectedItem}">
                                        <MenuItem.Icon>
                                            <Image Source="{StaticResource FluentTerminalIcon}" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator Background="#E0E0E0"/>
                                    <MenuItem Header="New remote folder..." Click="NewRemoteFolder_Click">
                                        <MenuItem.Icon>
                                            <Image Source="{StaticResource FluentNewFolderIcon}" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Rename..." Click="RenameRemoteItem_Click">
                                        <MenuItem.Icon>
                                            <Image Source="{StaticResource FluentRenameIcon}" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Delete remote item" Click="DeleteRemoteItem_Click">
                                        <MenuItem.Icon>
                                            <Image Source="{StaticResource FluentDeleteIcon}" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator Background="#E0E0E0"/>
                                    <MenuItem Header="Refresh list" Command="{Binding RemoteBrowser.RefreshCommand}">
                                        <MenuItem.Icon>
                                            <Image Source="{StaticResource FluentRefreshIcon}" Width="16" Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Name" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                                <!-- Icon for Parent Folder '..' -->
                                                <ContentControl ContentTemplate="{StaticResource FolderUpIconTemplate}" Focusable="False"
                                                                Margin="0,0,6,0" VerticalAlignment="Center"
                                                                Visibility="{Binding IsParent, Converter={StaticResource BoolToVisConverter}}"/>

                                                <!-- Native Windows Shell Icon for files, folders, and drives -->
                                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding IsParent, Converter={StaticResource InverseBoolToVisConverter}}"/>

                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Size" Binding="{Binding DisplaySize}" Width="90" ElementStyle="{StaticResource DataGridTextCellElementStyle}"/>
                                <DataGridTextColumn Header="Permissions" Binding="{Binding Permissions}" Width="95" ElementStyle="{StaticResource DataGridTextCellElementStyle}"/>
                                <DataGridTextColumn Header="Modified" Binding="{Binding LastWriteTime, StringFormat='dd/MM/yyyy HH:mm'}" Width="130" ElementStyle="{StaticResource DataGridTextCellElementStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 3. SPLITTER -->
        <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" Background="#D0D0D0" Cursor="SizeNS"/>

        <!-- 4. BOTTOM TABS: TRANSFERS, FAILED, COMPLETED & LOGS -->
        <TabControl Grid.Row="4" Margin="8,4,8,4">
            <!-- TAB 1: ACTIVE & PENDING TRANSFERS QUEUE -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource FluentQueueIcon}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ActiveTabHeader}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Background="#FFFFFF">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding ActiveTransfers}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChild}" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="28">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                      Click="ToggleExpandFolder_Click"
                                                      Visibility="{Binding IsExpandable, Converter={StaticResource BoolToVisConverter}}"
                                                      Style="{StaticResource ExpandCollapseToggleStyle}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Cursor="Hand"
                                                      ToolTip="Expand / Collapse folder files"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusBadge}" Width="110" ElementStyle="{StaticResource DataGridTextCellElementStyle}"/>
                            <DataGridTemplateColumn Header="Direction" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                            <Image Source="{StaticResource FluentArrowUpIcon}" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"
                                                   Visibility="{Binding IsUpload, Converter={StaticResource BoolToVisConverter}}"/>
                                            <Image Source="{StaticResource FluentArrowDownIcon}" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"
                                                   Visibility="{Binding IsUpload, Converter={StaticResource InverseBoolToVisConverter}}"/>
                                            <TextBlock Text="{Binding DirectionText}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="File / Folder" Width="260">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                            <TextBlock Text="      ↳ " Foreground="#7F8C8D" FontWeight="Normal" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsChild, Converter={StaticResource BoolToVisConverter}}"/>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Progress" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2" VerticalAlignment="Center">
                                            <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="16" Foreground="#0078D7" Background="#EAEAEA"/>
                                            <TextBlock Text="{Binding ProgressSummary}" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                       FontSize="11" FontWeight="Bold" Foreground="#111111"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Speed" Binding="{Binding Speed}" Width="95" ElementStyle="{StaticResource DataGridTextCellElementStyle}"/>
                            <DataGridTextColumn Header="ETA" Binding="{Binding Eta}" Width="75" ElementStyle="{StaticResource DataGridTextCellElementStyle}"/>
                            <DataGridTextColumn Header="Details" Binding="{Binding LiveStatusDetail}" Width="*" ElementStyle="{StaticResource DataGridTextCellElementStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="6">
                        <Button Command="{Binding CancelAllTransfersCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" Foreground="#C62828" FontWeight="SemiBold" Padding="10,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource FluentDeleteIcon}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Cancel all (active &amp; pending)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 2: FAILED TRANSFERS WITH RETRY -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource FluentFailedIcon}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FailedTabHeader}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Background="#FFFFFF">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding FailedTransfers}" SelectedItem="{Binding SelectedFailedTransfer, Mode=TwoWay}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChild}" Value="True">
                                        <Setter Property="Background" Value="#FFF8F8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="28">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                      Click="ToggleExpandFolder_Click"
                                                      Visibility="{Binding IsExpandable, Converter={StaticResource BoolToVisConverter}}"
                                                      Style="{StaticResource ExpandCollapseToggleStyle}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Cursor="Hand"
                                                      ToolTip="Expand / Collapse folder files"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusBadge}" Width="110" ElementStyle="{StaticResource DataGridTextCellElementStyle}"/>
                            <DataGridTemplateColumn Header="Direction" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                            <Image Source="{StaticResource FluentArrowUpIcon}" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"
                                                   Visibility="{Binding IsUpload, Converter={StaticResource BoolToVisConverter}}"/>
                                            <Image Source="{StaticResource FluentArrowDownIcon}" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"
                                                   Visibility="{Binding IsUpload, Converter={StaticResource InverseBoolToVisConverter}}"/>
                                            <TextBlock Text="{Binding DirectionText}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="File" Width="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                            <TextBlock Text="      ↳ " Foreground="#7F8C8D" FontWeight="Normal" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsChild, Converter={StaticResource BoolToVisConverter}}"/>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Error / Cause" Binding="{Binding ErrorMessage}" Width="280" ElementStyle="{StaticResource DataGridTextCellElementStyle}"/>
                            <DataGridTextColumn Header="Exit Code" Binding="{Binding ExitCode}" Width="70" ElementStyle="{StaticResource DataGridTextCellElementStyle}"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding DisplaySource}" Width="*" ElementStyle="{StaticResource DataGridTextCellElementStyle}"/>
                            <DataGridTextColumn Header="Destination" Binding="{Binding DisplayDestination}" Width="*" ElementStyle="{StaticResource DataGridTextCellElementStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="6">
                        <Button Command="{Binding RetrySelectedFailedCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource FluentRefreshIcon}" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Retry selected" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RetryAllFailedCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource FluentRefreshIcon}" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Retry all failed" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Clear failed" Command="{Binding ClearFailedCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" Padding="10,4"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 3: COMPLETED TRANSFERS -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource FluentCompletedIcon}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CompletedTabHeader}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Background="#FFFFFF">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding CompletedTransfers}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChild}" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="28">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                      Click="ToggleExpandFolder_Click"
                                                      Visibility="{Binding IsExpandable, Converter={StaticResource BoolToVisConverter}}"
                                                      Style="{StaticResource ExpandCollapseToggleStyle}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Cursor="Hand"
                                                      ToolTip="Expand / Collapse folder files"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusBadge}" Width="110" ElementStyle="{StaticResource DataGridTextCellElementStyle}"/>
                            <DataGridTemplateColumn Header="Direction" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                            <Image Source="{StaticResource FluentArrowUpIcon}" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"
                                                   Visibility="{Binding IsUpload, Converter={StaticResource BoolToVisConverter}}"/>
                                            <Image Source="{StaticResource FluentArrowDownIcon}" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"
                                                   Visibility="{Binding IsUpload, Converter={StaticResource InverseBoolToVisConverter}}"/>
                                            <TextBlock Text="{Binding DirectionText}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="File" Width="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                            <TextBlock Text="      ↳ " Foreground="#7F8C8D" FontWeight="Normal" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsChild, Converter={StaticResource BoolToVisConverter}}"/>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Size" Binding="{Binding DisplaySize}" Width="90" ElementStyle="{StaticResource DataGridTextCellElementStyle}"/>
                            <DataGridTextColumn Header="Exit Code" Binding="{Binding ExitCode}" Width="70" ElementStyle="{StaticResource DataGridTextCellElementStyle}"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding DisplaySource}" Width="*" ElementStyle="{StaticResource DataGridTextCellElementStyle}"/>
                            <DataGridTextColumn Header="Destination" Binding="{Binding DisplayDestination}" Width="*" ElementStyle="{StaticResource DataGridTextCellElementStyle}"/>
                            <DataGridTextColumn Header="Completed At" Binding="{Binding EndTime, StringFormat='HH:mm:ss'}" Width="95" ElementStyle="{StaticResource DataGridTextCellElementStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="6">
                        <Button Content="Clear history" Command="{Binding ClearCompletedCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 4: SERVER & RSYNC CONSOLE LOG -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource FluentTerminalIcon}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Server &amp; rsync Log" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Background="#FAFAFA">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0" x:Name="LogListBox" 
                             ItemsSource="{Binding LogEntries}"
                             Background="#FAFAFA" BorderThickness="0"
                             FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,1">
                                    <TextBlock Text="{Binding FormattedTime, StringFormat='[{0}] '}" Foreground="#757575" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Message}" Foreground="{Binding ColorBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="6">
                        <Button Content="Clear log" Command="{Binding ClearLogsCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 5. STATUS BAR -->
        <Border Grid.Row="5" Background="#E9ECEF" BorderBrush="#CED4DA" BorderThickness="0,1,0,0" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="#495057" FontSize="12" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FooterInfo}" Foreground="#6C757D" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
